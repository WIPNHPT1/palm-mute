          "name": "Octave riff",
          "shapes": ["OctA", "OctE"],
          "rhythms": {
            "fast-punk": { "bars": ["DUDUDUDU", "DUDUD-DU"], "articulation": ["ring"], "accents": [0] },
            "half-time": { "bars": ["D-DUD-DU"], "articulation": ["ring"], "accents": [0, 4] },
            "mid-tempo": { "bars": ["D-.UD-.U"], "articulation": ["ring"], "accents": [0] }
          }
        },
        {
          "name": "Chugs into open hits",
          "shapes": ["E2", "A2", "D2"],
          "rhythms": {
            "fast-punk": { "bars": ["DDDDDDDD", "DDDDDDDD", "D---D---", "D---D-DD"], "articulation": ["pm", "pm", "ring", "ring"], "accents": [0] },
            "half-time": { "bars": ["D..D..D.", "D..D..D.", "D-----D-", "D-----DD"], "articulation": ["pm", "pm", "ring", "ring"], "accents": [0] },
            "mid-tempo": { "bars": [".U.U.U.U", ".U.U.U.U", "D---D---", "D---D-D-"], "articulation": ["pm", "pm", "ring", "ring"], "accents": [] }
          }
        }
      ]
    },
    "verse": {
