            "pop-strum": { "bars": ["D.D.D.D.", "D.D.D.D.", "D-D-D-D-", "D-DUDUDU"], "articulation": ["pm", "pm", "ring", "ring"], "accents": [0, 4] },
            "ballad": { "bars": ["D...D...", "D...D...", "D---D---", "D-D-D-D-"], "articulation": ["pm", "pm", "ring", "ring"], "accents": [0, 4] }
