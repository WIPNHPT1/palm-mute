            "half-time": { "bars": ["D---D-DD"], "articulation": ["ring"], "accents": [0, 4], "pushes": [0, 2] },
            "mid-tempo": { "bars": ["D--UD-DU"], "articulation": ["ring"], "accents": [0], "pushes": [0, 2] }
