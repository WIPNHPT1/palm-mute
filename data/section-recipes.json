      "register": "low",
      "openStrings": true,
      "repeat": 1,
      "variants": [
        {
          "name": "Octave riff",
          "shapes": ["OctA", "OctE"],
          "rhythms": {
            "fast-punk": { "bars": ["DDDDDDDD", "DDDDD-DD"], "articulation": ["ring"], "accents": [0] },
            "half-time": { "bars": ["D-DUD-DU"], "articulation": ["ring"], "accents": [0, 4] },
            "mid-tempo": { "bars": ["D-.UD-.U"], "articulation": ["ring"], "accents": [0] },
            "pop-strum": { "bars": ["D-DU-UDU"], "articulation": ["ring"], "accents": [0] },
            "ballad": { "bars": ["D---D---"], "articulation": ["ring"], "accents": [0, 4] }
          }
        },
        {
          "name": "Chugs into open hits",
          "shapes": ["E2", "A2"],
          "rhythms": {
            "fast-punk": { "bars": ["DDDDDDDD", "DDDDDDDD", "D---D---", "D---D-DD"], "articulation": ["pm", "pm", "ring", "ring"], "accents": [0] },
            "half-time": { "bars": ["D..D..D.", "D..D..D.", "D-----D-", "D-----DD"], "articulation": ["pm", "pm", "ring", "ring"], "accents": [0] },
            "mid-tempo": { "bars": [".U.U.U.U", ".U.U.U.U", "D---D---", "D---D-D-"], "articulation": ["pm", "pm", "ring", "ring"], "accents": [] },
            "pop-strum": { "bars": ["D.DU.UDU", "D.DU.UDU", "D---D---", "D---D-DU"], "articulation": ["pm", "pm", "ring", "ring"], "accents": [0] },
            "ballad": { "bars": ["D.D.D.D.", "D.D.D.D.", "D-------", "D---D---"], "articulation": ["pm", "pm", "ring", "ring"], "accents": [0] }
          }
        }
      ]
    },
    "verse": {
