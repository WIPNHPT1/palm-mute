            "half-time": { "bars": ["D..D..D."], "articulation": ["pm"], "accents": [0] },
            "mid-tempo": { "bars": [".U.U.U.U"], "articulation": ["pm"], "accents": [] }
          }
        },
        {
          "name": "Chugs with a dead-strum turnaround",
          "shapes": ["E2", "A2", "D2", "E3", "A3"],
          "rhythms": {
            "fast-punk": { "bars": ["DDDDDDDD", "DDDDDDxx"], "articulation": ["pm"], "accents": [0, 3] },
            "half-time": { "bars": ["D..D..D.", "D..D.xDx"], "articulation": ["pm"], "accents": [0] },
            "mid-tempo": { "bars": [".U.U.U.U", ".U.U.UxU"], "articulation": ["pm"], "accents": [] }
          }
        },
        {
          "name": "Offbeat accents",
          "shapes": ["E2", "A2", "D2", "E3", "A3"],
          "rhythms": {
            "fast-punk": { "bars": ["DDDDDDDD"], "articulation": ["pm"], "accents": [0, 3, 6] },
            "half-time": { "bars": ["D..D.DD."], "articulation": ["pm"], "accents": [0, 3] },
            "mid-tempo": { "bars": [".UDU.UDU"], "articulation": ["pm"], "accents": [] }
          }
        }
      ]
